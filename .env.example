# Copy to .env — every value has a working default, so the project runs even untouched.
VITE_APP_NAME=HRSuite
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# Publishable key only (sb_publishable_...). It is safe for the browser.
# NEVER put secret keys (sb_secret_...) or service-role keys here —
# VITE_* values are embedded in the frontend bundle. Secrets belong in
# Supabase Edge Functions (auto-injected server-side).
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
VITE_TARGET_HOURS=160
VITE_SHIFT_HOURS=8
VITE_GRACE_MINUTES=10
VITE_PORT=5173
